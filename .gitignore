# Komponen yang diunduh ulang dengan "npm install"
node_modules/
# Hasil build installer
dist/
# File sistem macOS
.DS_Store
# File sementara
*.log

# SDK kamera (berlisensi, jangan masuk Git)
sdk/
# Hasil build & uji kamera Sony (dibuat ulang dengan npm run build:sony / uji:sony)
kamera-sony/bin/
kamera-sony/.sdk/
kamera-sony/uji/bin/
kamera-sony/hasil-uji/
# Hasil pemasangan server QR (berisi kunci booth) & berkas kerja wrangler
cloud/.hasil-pasang.json
cloud/.wrangler/
# Hasil bangun demo HP (dibuat ulang dengan npm run demo:bangun)
demo/web/
demo/.wrangler/

# Pengaturan VS Code pribadi
.vscode/
